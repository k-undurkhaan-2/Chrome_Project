globalalloc(last_rdx,8)
globalalloc(last_rax,8)
globalalloc(last_addr,8)

[ENABLE]

aobscan(INJECT,48 8B 75 ?? 48 8B 56 17 C5 FA 10 44 0A 28 8B 4D ?? C5 82 2A C9 C5 FA 5C C1 C5 FA 11 44 02 28 8B 45 ?? 8B 4D ??)
alloc(newmem,$1000,INJECT)

label(return)

registersymbol(INJECT)

assert(INJECT+19,C5 FA 11 44 02 28)

newmem:
  push rbx
  push rcx

  mov rbx,last_rdx
  mov [rbx],rdx

  mov rbx,last_rax
  mov [rbx],rax

  lea rcx,[rdx+rax+28]
  mov rbx,last_addr
  mov [rbx],rcx

  pop rcx
  pop rbx

  vmovss [rdx+rax+28],xmm0
  jmp return

INJECT+19:
  jmp newmem
  nop
return:

[DISABLE]

INJECT+19:
  db C5 FA 11 44 02 28

unregistersymbol(INJECT)
dealloc(newmem)
