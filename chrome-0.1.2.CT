alloc(newmem,$1000,INJECT)

label(return)

registersymbol(INJECT)

assert(INJECT+19,C5 FA 11 44 02 28)

newmem:
  push rbx
  push rcx

  mov rbx,last_rdx
  mov [rbx],rdx

  mov rbx,last_rax
  mov [rbx],rax

  lea rcx,[rdx+rax+28]
  mov rbx,last_addr
  mov [rbx],rcx

  pop rcx
  pop rbx

  vmovss [rdx+rax+28],xmm0
  jmp return

INJECT+19:
  jmp newmem
  nop
return:

[DISABLE]

INJECT+19:
  db C5 FA 11 44 02 28

unregistersymbol(INJECT)
dealloc(newmem)
</AssemblerScript>
