{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:armedforces:qsg:event:v1",
  "title": "QSG synthetic sidecar; no live origin permitted",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "origin",
    "source",
    "session_id",
    "sequence",
    "clock_origin",
    "clock_ms",
    "kind",
    "body",
    "previous",
    "digest"
  ],
  "properties": {
    "schema": {
      "const": "qsg.event.v1"
    },
    "origin": {
      "const": "SYNTHETIC"
    },
    "source": {
      "const": "ce-qsg"
    },
    "session_id": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "clock_origin": {
      "const": "synthetic-ce-ms"
    },
    "clock_ms": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "kind": {
      "enum": [
        "READY",
        "CANDIDATE",
        "PERMIT_REQUEST",
        "RESERVATION",
        "RAW_DISPATCH",
        "RAW_RETURN",
        "VERIFIED",
        "FAILED_CLOSED"
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease",
        "phase",
        "data"
      ],
      "properties": {
        "lease": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "writer_id",
            "epoch",
            "target",
            "generation"
          ],
          "properties": {
            "run_id": {
              "type": "string"
            },
            "writer_id": {
              "type": "string"
            },
            "epoch": {
              "type": "string"
            },
            "target": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            }
          }
        },
        "phase": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "previous": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "READY"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "properties": {
              "data": {
                "additionalProperties": false,
                "required": [
                  "policy_digest"
                ],
                "properties": {
                  "policy_digest": {}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "CANDIDATE"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "properties": {
              "data": {
                "additionalProperties": false,
                "required": [
                  "address",
                  "mapping",
                  "fields",
                  "rank_sequence",
                  "population_sequence",
                  "alias",
                  "qualified_count",
                  "hard_pass",
                  "recommendation",
                  "raw_count",
                  "scanned_count",
                  "filtered_count",
                  "selected_count"
                ],
                "properties": {
                  "address": {},
                  "mapping": {},
                  "fields": {},
                  "rank_sequence": {},
                  "population_sequence": {},
                  "alias": {},
                  "qualified_count": {},
                  "hard_pass": {},
                  "recommendation": {},
                  "raw_count": {},
                  "scanned_count": {},
                  "filtered_count": {},
                  "selected_count": {}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "PERMIT_REQUEST"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "properties": {
              "data": {
                "additionalProperties": false,
                "required": [
                  "request_digest",
                  "operation_id"
                ],
                "properties": {
                  "request_digest": {},
                  "operation_id": {}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RESERVATION"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "properties": {
              "data": {
                "additionalProperties": false,
                "required": [
                  "attempt",
                  "request_digest",
                  "receipt_kind"
                ],
                "properties": {
                  "attempt": {},
                  "request_digest": {},
                  "receipt_kind": {}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RAW_DISPATCH"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "properties": {
              "data": {
                "additionalProperties": false,
                "required": [
                  "attempt",
                  "receipt",
                  "address",
                  "bits"
                ],
                "properties": {
                  "attempt": {},
                  "receipt": {},
                  "address": {},
                  "bits": {}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RAW_RETURN"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "properties": {
              "data": {
                "additionalProperties": false,
                "required": [
                  "attempt",
                  "result"
                ],
                "properties": {
                  "attempt": {},
                  "result": {}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "VERIFIED"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "properties": {
              "data": {
                "additionalProperties": false,
                "required": [
                  "attempt",
                  "address",
                  "bits",
                  "core_sequence",
                  "target",
                  "readback"
                ],
                "properties": {
                  "attempt": {},
                  "address": {},
                  "bits": {},
                  "core_sequence": {},
                  "target": {},
                  "readback": {}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "FAILED_CLOSED"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "properties": {
              "data": {
                "additionalProperties": false,
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$comment": "Digest is SHA-256 over sorted compact ASCII JSON excluding digest. Target checkpoint payloads are canonical JSON strings preserving null/empty arrays. Runtime recorder and independent verifier additionally validate kind-specific types, relationships, scope, counters and causal links; this schema alone is not admission authority."
}
