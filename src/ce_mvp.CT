<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"H3-A7 Start (uncheck to Stop; see Lua output for status)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript><![CDATA[[ENABLE]
{$lua}
if syntaxcheck then return end
local entrypoint=nil -- H3A7_LOCAL_ENTRYPOINT
assert(entrypoint, 'CE_MVP_TABLE_NOT_PREPARED: run src/prepare_ce_mvp.py, then load src/ce_mvp.local.CT')
if H3A7_CE_MVP then
  assert(debug.getinfo(H3A7_CE_MVP.start, 'S').source=='@'..entrypoint,
    'CE_MVP_DIFFERENT_INSTALLATION_RELOAD_CE')
end
local m=dofile(entrypoint)
local controlled=false -- G1_ALPHA_CONTROLLED
if controlled then
  local configured,reason=m.configure_execution({mode='ALPHA_CONTROLLED'})
  if not configured then error(reason) end
end
local ok,reason=m.start()
if not ok then error(reason) end
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if H3A7_CE_MVP then H3A7_CE_MVP.stop() end
{$asm}
]]></AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>2</ID>
      <Description>"H3-A7 Status (toggle to print)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript><![CDATA[[ENABLE]
{$lua}
if syntaxcheck then return end
if H3A7_CE_MVP then H3A7_CE_MVP.status() else print('[H3-A7] STOPPED') end
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if H3A7_CE_MVP then H3A7_CE_MVP.status() end
{$asm}
]]></AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>3</ID>
      <Description>"G1 Full population - READ ONLY synthetic example (check once; uncheck is inert)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript><![CDATA[[ENABLE]
{$lua}
if syntaxcheck then return end
local entrypoint=nil -- G1_READONLY_LOCAL_ENTRYPOINT
assert(entrypoint, 'CE_MVP_TABLE_NOT_PREPARED: run src/prepare_ce_mvp.py, then load src/ce_mvp.local.CT')
dofile(entrypoint).run_example()
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
-- One synchronous invocation only. Disabling never evaluates or starts recovery.
{$asm}
]]></AssemblerScript>
    </CheatEntry>
  </CheatEntries>
</CheatTable>
