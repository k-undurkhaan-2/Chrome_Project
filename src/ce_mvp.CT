<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"Start: attach config PID, scan, rank, write and monitor (uncheck to stop)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript><![CDATA[[ENABLE]
{$lua}
if syntaxcheck then return end
local config_path=nil -- CE_MVP_CONFIG_PATH
local sources={} -- CE_MVP_SOURCES
assert(config_path and sources['ce_mvp.lua'], 'Run prepare_ce_mvp.py and open ce_mvp.local.CT')
if CE_MVP_PRODUCT then
  local previous=CE_MVP_PRODUCT.status()
  assert(not previous.running, 'Already running: uncheck ID1 first')
  assert(previous.cleanup_ok~=false, 'Restart CE after cleanup failure')
end
-- A moved table reads the config beside the opened table. The prepared path
-- supports CE hosts that do not expose the opened table's filename.
local filename=getMainForm().SaveDialog1.FileName
if type(filename)=='string' and (filename:match('^%a:[/\\]') or filename:match('^[/\\][/\\]')) then
  config_path=assert(filename:match('^(.*[/\\])'))..'ce_mvp_config.local.lua'
end
local m=assert(load(sources['ce_mvp.lua'],'@ce_mvp.lua','t',_G))()
CE_MVP_PRODUCT=m
local list=getAddressList()
local ok,reason=m.start(config_path,sources,list.getMemoryRecordByID(1),list.getMemoryRecordByID(3))
if not ok then error(reason) end
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if CE_MVP_PRODUCT then CE_MVP_PRODUCT.stop() end
{$asm}
]]></AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>2</ID>
      <Description>"Status (toggle to print)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript><![CDATA[[ENABLE]
{$lua}
if syntaxcheck then return end
if CE_MVP_PRODUCT then CE_MVP_PRODUCT.print_status() else print('[CE MVP] STOPPED') end
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if CE_MVP_PRODUCT then CE_MVP_PRODUCT.print_status() end
{$asm}
]]></AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>3</ID>
      <Description>"Selected address: live Float value"</Description>
      <VariableType>Float</VariableType>
      <Address>0</Address>
    </CheatEntry>
  </CheatEntries>
</CheatTable>
